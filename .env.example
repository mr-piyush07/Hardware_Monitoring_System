# Security
DEBUG=False
SECRET_KEY=change-this-to-a-super-secret-50-character-random-string-in-production
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.onrender.com
CORS_ALLOW_ALL=False

# Public API URL Override for Firmware Generator (Optional)
# If empty, automatically detects your live domain URL on Render!
# Example: PUBLIC_API_URL=https://my-custom-domain.com
PUBLIC_API_URL=

# Database Abstraction
# Options: 'sqlite', 'postgresql', 'mongodb'
# On Render Web Service, DATABASE_URL is set automatically by Render
DB_ENGINE=postgresql

# PostgreSQL Options
POSTGRES_DB=iot_dashboard_gen7
POSTGRES_USER=iot_dashboard_gen7_user
POSTGRES_PASSWORD=J4icgWEaGCcpbjor9JnZi9lQrCKLAFig
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional MongoDB Options
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=iot_monitoring

# Telemetry Protocols (MQTT)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
